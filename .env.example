# Zorq environment template. Replace placeholders in local/staging secret stores.
# Never place secret values in NEXT_PUBLIC_* variables or commit a populated env file.

# Web app
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zorq
PORTALDOT_CHAIN_ID=420420777
PORTALDOT_EVM_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_CONFIRMATION_DEPTH=6
ZORQ_CONTRACT_ADDRESS=
NEXT_PUBLIC_PORTALDOT_CHAIN_ID=420420777
NEXT_PUBLIC_PORTALDOT_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
NEXT_PUBLIC_PORTALDOT_EXPLORER_URL=https://scanner-testnet-v3.portaldot.dev/
NEXT_PUBLIC_ZORQ_CONTRACT_ADDRESS=
NEXT_PUBLIC_GITHUB_REPOSITORY_URL=https://github.com/onyebuchidaniel60/Zorq
FL_SERVICE_URL=http://localhost:8000
FL_SERVICE_SHARED_SECRET=replace-with-a-long-random-token
FL_SERVICE_TIMEOUT_MS=10000
RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Python FL service (local)
ZORQ_INTERNAL_API_BASE_URL=http://localhost:3000
FL_SERVICE_MODE=simulation
FLOWER_MAX_CONCURRENT_RUNS=1
FLOWER_MAX_PARTICIPANTS=5
DEMO_DATA_SEED=20261104
PYTHONUNBUFFERED=1

# Contract deployment. Use a dedicated disposable testnet deployer key in a secure
# local/CI secret store. Leave blank for local Hardhat deployment with a local key.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_SS58_SEED=
CONTRACT_OWNER_ADDRESS=
